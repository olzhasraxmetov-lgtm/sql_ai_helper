# Скопируйте в .env и поменяйте пароли. Без .env compose возьмёт значения по умолчанию.

# PostgreSQL. admin — суперпользователь контейнера, нужен только для создания ролей.
# DB_HOST=db внутри compose задаётся сам; localhost — для тестов и alembic с хоста.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookstore
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres
DB_MIGRATOR_PASSWORD=migrator
DB_APP_SERVICE_PASSWORD=app_service
DB_LLM_READONLY_PASSWORD=llm_readonly

# Сервис
APP_LOG_LEVEL=INFO
